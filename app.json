{
  "expo": {
    "name": "Sri Satyanarayana Temple",
    "slug": "sstgh-temple",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sstgh",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sstgh.temple",
      "buildNumber": "3",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Sri Satyanarayana Temple sends notifications for upcoming events, pujas, and announcements.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFAF6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sstgh.temple",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#8B1A1A",
          "defaultChannel": "temple-updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sri Satyanarayana Temple needs access to your photo library to upload gallery images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#8B1A1A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78fb3f0d-1af4-43ed-a1a3-d95b1c568cd7"
      }
    },
    "owner": "mohith1017"
  }
}
